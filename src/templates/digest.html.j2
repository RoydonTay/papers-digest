<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Weekly Top {{ paper_count }} Research Papers Digest - {{ week }}</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f4f7;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f4f7;">
  <tr>
    <td align="center" style="padding:24px 12px;">
      <table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="max-width:640px; width:100%; background-color:#ffffff; border-radius:6px; overflow:hidden; font-family:Arial, Helvetica, sans-serif;">

        <!-- Header -->
        <tr>
          <td style="background-color:#1a1a2e; padding:24px 28px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="color:#ffffff; font-size:20px; font-weight:bold;">
                  Weekly Top {{ paper_count }} Research Papers Digest
                </td>
              </tr>
              <tr>
                <td style="color:#c5c6d0; font-size:13px; padding-top:6px;">
                  Week {{ week }} &middot; Generated {{ generated_on }} &middot; {{ paper_count }} papers
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Papers -->
        {% for item in items %}
        <tr>
          <td style="padding:20px 28px; {% if not loop.last %}border-bottom:1px solid #e5e5ea;{% endif %}">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="font-size:13px; color:#8888a0; font-weight:bold; padding-bottom:4px;">
                  #{{ item.rank }}
                </td>
              </tr>
              <tr>
                <td style="font-size:16px; font-weight:bold; padding-bottom:6px;">
                  <a href="{{ item.paper.hf_url }}" style="color:#1a1a2e; text-decoration:none;">{{ item.paper.title }}</a>
                </td>
              </tr>
              <tr>
                <td style="font-size:12px; color:#5555aa; padding-bottom:8px;">
                  <a href="{{ item.paper.arxiv_url }}" style="color:#5555aa;">View on arXiv</a>
                </td>
              </tr>
              <tr>
                <td style="font-size:12px; color:#666677; padding-bottom:8px;">
                  {{ format_authors(item.paper.authors) }} &middot; {{ item.paper.published_at }} &middot; {{ item.paper.upvotes }} upvotes
                </td>
              </tr>
              {% if item.matched_areas %}
              <tr>
                <td style="padding-bottom:10px;">
                  {% for area in item.matched_areas %}
                  <span style="display:inline-block; background-color:#eef0fb; color:#3a3a8c; font-size:11px; padding:3px 8px; border-radius:10px; margin-right:4px;">{{ area }}</span>
                  {% endfor %}
                </td>
              </tr>
              {% endif %}
              <tr>
                <td style="font-size:14px; color:#333344; line-height:1.5; padding-bottom:10px;">
                  {{ item.summary }}
                </td>
              </tr>
              <tr>
                <td style="border-left:3px solid #5555aa; background-color:#f7f7fc; padding:10px 12px; font-size:13px; color:#444455; line-height:1.4;">
                  {{ item.relevance_note }}
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% endfor %}

        <!-- Footer -->
        <tr>
          <td style="padding:20px 28px; background-color:#f4f4f7; font-size:11px; color:#888899; line-height:1.6;">
            Source: <a href="https://huggingface.co/papers" style="color:#888899;">Hugging Face Daily Papers</a><br>
            {% if all_llm_generated %}
            Summaries generated by Gemini based on paper abstracts.
            {% else %}
            Some or all summaries below were extracted directly from abstracts (LLM enrichment unavailable this run) rather than generated by a model.
            {% endif %}
            <br>
            Built by the <a href="https://github.com/" style="color:#888899;">weekly-papers-digest</a> pipeline.
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>
</body>
</html>
